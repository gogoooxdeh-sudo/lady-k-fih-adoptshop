# FUTURE INTEGRATIONS ONLY — the current static app does not read these values.
# Copy to .env only when implementing the corresponding secure integration.
# Never commit .env or put server secrets in browser JavaScript.

# Supabase project URL and publishable/anon key may be used by a browser client
# only after secure authentication and restrictive Row Level Security are configured.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY — configure as Supabase Edge Function / server deployment secrets.
# Never expose service role keys or Telegram bot credentials in public frontend code.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

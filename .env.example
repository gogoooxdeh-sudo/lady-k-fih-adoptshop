# Server-side integration secrets only. Configure these in Supabase Edge Function Secrets.
# Never commit .env or put server secrets in browser JavaScript.

# Supabase project URL and publishable/anon key may be used by a browser client
# only after secure authentication and restrictive Row Level Security are configured.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY — configure as Supabase Edge Function secrets.
# Supabase injects its own service role / secret key; do not add it here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
